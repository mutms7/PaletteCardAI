PALETTECARD_HOST=0.0.0.0
PALETTECARD_PORT=7860
PALETTECARD_OUTPUT_DIR=artifacts/cards
PALETTECARD_CHECKPOINT=artifacts/checkpoints/best.pt
PALETTECARD_PALETTE_CHECKPOINT=artifacts/checkpoints/palette.pt
PALETTECARD_REQUIRE_MODELS=true

# Upload/privacy/resource limits
PALETTECARD_MAX_UPLOAD_MB=10
PALETTECARD_MAX_PIXELS=16000000
PALETTECARD_CONCURRENCY=2
PALETTECARD_QUEUE_SIZE=32
PALETTECARD_RETENTION_HOURS=24

# Replace with the public hostname before deployment.
PALETTECARD_ALLOWED_HOSTS=localhost,127.0.0.1
PALETTECARD_FORWARDED_ALLOW_IPS=127.0.0.1
PALETTECARD_LOG_LEVEL=info
GRADIO_ANALYTICS_ENABLED=False
# Set false for the lean Vercel API; keep true for the optional /studio route.
PALETTECARD_MOUNT_GRADIO=true

# Optional basic authentication. Set both or neither; inject real values as
# secrets in the hosting platform rather than committing them.
# PALETTECARD_USERNAME=
# PALETTECARD_PASSWORD=
